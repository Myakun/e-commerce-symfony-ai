FROM php:8.5-fpm

RUN set -eux \
	&& DEBIAN_FRONTEND=noninteractive apt-get update -qq \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -qq -y --no-install-recommends --no-install-suggests \
		ca-certificates \
		git \
		iproute2 \
		iputils-ping \
		libicu-dev \
		libpq-dev \
		libzip-dev \
		postgresql-client \
		unzip \
		zip \
		zlib1g-dev \
	&& rm -rf /var/lib/apt/lists/*

RUN set -eux \
	&& docker-php-ext-install -j$(getconf _NPROCESSORS_ONLN) intl pdo_pgsql sockets zip

RUN set -eux \
	&& pecl install xdebug-3.5.3 \
	&& docker-php-ext-enable xdebug

# Map www-data to the host user, so files created in the bind mount
# (by php-fpm, composer, bin/console) belong to the developer
ARG UID=1000
ARG GID=1000
RUN set -eux \
	&& groupmod -o -g ${GID} www-data \
	&& usermod -o -u ${UID} -g ${GID} www-data

ENV COMPOSER_HOME=/var/www/.composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer
ADD composer/auth.json /var/www/.composer/auth.json
RUN chown -R www-data:www-data /var/www/.composer
RUN git config --system --add safe.directory /var/www/app

RUN mv $PHP_INI_DIR/php.ini-development $PHP_INI_DIR/php.ini
ADD php-local.ini /usr/local/etc/php/conf.d/zzz-custom.ini

COPY docker-entrypoint-local.sh /usr/local/bin/docker-entrypoint-local
RUN chmod +x /usr/local/bin/docker-entrypoint-local
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-local"]

WORKDIR /var/www/app

CMD ["php-fpm"]
