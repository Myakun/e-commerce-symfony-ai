server {
    listen ${APP_HTTP_PORT};

    server_name ${APP_HTTP_DOMAIN};
    root ${APP_DIR}/public;

    #error_log  /var/log/nginx/${APP_HTTP_DOMAIN}.error.log;
    #access_log /var/log/nginx/${APP_HTTP_DOMAIN}.access.log;
    access_log off;

    charset UTF-8;

    resolver 127.0.0.11 valid=10s;

    location ~ ^/(api|_profiler|_wdt|bundles)(/|$) {
        try_files $uri /index.php$is_args$args;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_pass php:9000;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        internal;
    }

    location ~ \.php$ {
        return 404;
    }

    location / {
        set $frontend http://frontend:3000;
        proxy_pass $frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
